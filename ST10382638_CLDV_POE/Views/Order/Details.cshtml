@model ST10382638_CLDV_POE.Models.Order
@{
    ViewData["Title"] = $"Order {Model?.RowKey}";
    var returnUrl = (string?)ViewData["returnUrl"] ?? Url.Action("MyOrders", "Order");
    string BadgeClass(string s) => s?.ToLowerInvariant() switch
    {
        "placed" => "status-placed",
        "processed" => "status-processed",
        "completed" => "status-completed",
        "cancelled" => "status-cancelled",
        _ => "status-default"
    };
}

<div class="page-head">
    <h1>Order @Model.RowKey</h1>
    <div class="page-sub">
        <span class="@BadgeClass(Model.Status)">@Model.Status</span>
        • @Model.OrderDate.ToString("yyyy-MM-dd HH:mm")
    </div>
</div>

<div class="glass-card" style="padding:1rem;">
    <h3 class="mb-3">Items</h3>
    <pre style="white-space:pre-wrap;">@Model.ItemsJson</pre>
    <div class="mt-3">
        <a class="btn btn-secondary" href="@returnUrl">Back</a>
    </div>
</div>
