@using ST10382638_CLDV_POE.Models
@model IEnumerable<ST10382638_CLDV_POE.Models.Order>
@{
    ViewData["Title"] = "My Orders";
    var q = Context.Request.Query["q"].ToString();
    var status = Context.Request.Query["status"].ToString();
    var statuses = OrderStatus.All;
    var names = ViewData["CustomerNames"] as IDictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="page-head">
    <h1>My Orders</h1>
</div>

<form method="get" class="glass-card" style="display:flex; gap:.75rem; flex-wrap:wrap; padding:1rem; margin-bottom:1rem;">
    <input class="form-control" type="text" name="q" value="@q" placeholder="Search by Order ID or Status" />
    <select class="form-select select-contrast" name="status">
        <option value="">Status: All</option>
        @foreach (var s in statuses)
        {
            <option value="@s" selected="@(string.Equals(status, s, StringComparison.OrdinalIgnoreCase))">@s</option>
        }
    </select>
    <button class="btn btn-primary" type="submit">Filter</button>
    <a class="btn btn-light" href="@Url.Action("MyOrders", "Order")">Reset</a>
</form>

<div class="glass-card" style="padding:0;">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Status</th>
                <th>Items</th>
                <th>Total</th>
                <th>Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.RowKey</td>
                    <td>@o.Status</td>
                    <td>@o.ItemCount</td>
                    <td>@o.TotalPrice.ToString("0.00")</td>
                    <td>@o.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           href="@Url.Action("Details", "Order", new { id = o.RowKey, returnUrl = Context.Request.Path + Context.Request.QueryString })">
                            View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
