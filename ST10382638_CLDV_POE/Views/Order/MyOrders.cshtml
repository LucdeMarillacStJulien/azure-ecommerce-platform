@using ST10382638_CLDV_POE.Models
@model IEnumerable<Order>

@{
    ViewData["Title"] = "My Orders";
    ViewData["Subtitle"] = "View and manage your orders";

    var q = Context.Request.Query["q"].ToString();
    var status = Context.Request.Query["status"].ToString();   // single variable for selected status
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var names = ViewData["CustomerNames"] as System.Collections.Generic.IDictionary<int, string>
                ?? new System.Collections.Generic.Dictionary<int, string>();
    var customerName = names.Values.FirstOrDefault() ?? "Customer";
    var statuses = OrderStatus.All;
}

<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-sub">@ViewData["Subtitle"] · @customerName</p>
        <p class="page-sub">Order my take time to appear (Auto refreshes)</p>
    </div>
</div>

<div class="search-card mb-3">
    <form method="get">
        <div class="row">
            <div class="col-12">
                <h5 class="mb-2">Filter my orders</h5>
            </div>
        </div>

        <div class="row g-2 align-items-end">
            <!-- Row 1: Order ID + Date range + Status -->
            <div class="col-12 col-md-3">
                <label class="form-label mb-1">Order ID</label>
                <input class="form-control" type="text" name="q" value="@q" placeholder="Search Order ID" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">From</label>
                <input class="form-control" type="date" name="dateFrom" value="@(ViewData["dateFrom"])" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">To</label>
                <input class="form-control" type="date" name="dateTo" value="@(ViewData["dateTo"])" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label mb-1">Status</label>
                <select class="form-select select-contrast" name="status">
                    <option value="">Status: All</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(string.Equals(status, s, StringComparison.OrdinalIgnoreCase))">@s</option>
                    }
                </select>
            </div>

            <!-- Row 2: Totals + Item counts -->
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Min total</label>
                <input class="form-control" type="number" step="0.01" name="minTotal" value="@(ViewData["minTotal"])" placeholder="e.g. 100.00" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Max total</label>
                <input class="form-control" type="number" step="0.01" name="maxTotal" value="@(ViewData["maxTotal"])" placeholder="e.g. 500.00" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Min items</label>
                <input class="form-control" type="number" name="minItems" value="@(ViewData["minItems"])" placeholder="e.g. 1" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Max items</label>
                <input class="form-control" type="number" name="maxItems" value="@(ViewData["maxItems"])" placeholder="e.g. 10" />
            </div>

            <!-- Row 3: Actions -->
            <div class="col-12 d-flex gap-2 justify-content-end">
                <a class="btn btn-outline-light" href="@Url.Action("MyOrders", "Order")" title="Reset">Reset</a>
                <button class="btn btn-primary" type="submit" title="Filter">
                    <i class="bi bi-search"></i> Apply
                </button>
            </div>
        </div>
    </form>
</div>

<div class="glass-card p-3" data-orders-autorefresh="true">
    @if (Model == null || !Model.Any())
    {
        <div class="empty">
            <i class="bi bi-box-seam icon"></i>
            <div>No orders yet.</div>
            <div class="mt-2">
                <a asp-controller="Shop" asp-action="Index" class="btn btn-primary btn-sm">
                    <i class="bi bi-cart-plus me-1"></i>Start shopping
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-neon table-compact align-middle">
                <thead class="table-head-sticky">
                    <tr>
                        <th class="text-start" style="width:10%;">Order ID</th>
                        <th class="text-start" style="width:25%;">Date</th>
                        <th class="text-center" style="width:10%;">Items</th>
                        <th class="text-end" style="width:15%;">Total</th>
                        <th class="text-center" style="width:15%;">Status</th>
                        <th class="text-end" style="width:15%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr data-row="order">
                            <td class="text-start">@p.RowKey</td>
                            <td class="text-start">@p.OrderDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td class="text-center">@p.ItemCount</td>
                            <td class="text-end price text-nowrap">R @p.TotalPrice.ToString("0.00")</td>
                            <td class="text-center">
                                @if (p.Status == "Placed")
                                {
                                    <span class="badge-soft status-placed rounded-pill px-2 py-1">@p.Status</span>
                                }
                                else if (p.Status == "Processed")
                                {
                                    <span class="badge-soft status-processing rounded-pill px-2 py-1">@p.Status</span>
                                }
                                else if (p.Status == "Completed")
                                {
                                    <span class="badge-soft status-completed rounded-pill px-2 py-1">@p.Status</span>
                                }
                                else if (p.Status == "Cancelled")
                                {
                                    <span class="badge-soft status-cancelled rounded-pill px-2 py-1">@p.Status</span>
                                }
                                else
                                {
                                    <span class="badge-soft rounded-pill px-2 py-1">@p.Status</span>
                                }
                            </td>
                            <td class="actions text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details"
                                       asp-route-id="@p.RowKey"
                                       asp-route-returnUrl="@Url.Action("MyOrders", "Order")"
                                       class="btn btn-outline-light" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-2 text-muted small">
            <i class="bi bi-info-circle me-1"></i>
            Times shown in your local timezone. Click <strong>Details</strong> for full breakdown.
        </div>
    }
</div>
