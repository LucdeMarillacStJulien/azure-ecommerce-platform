@model IEnumerable<ST10382638_CLDV_POE.Models.Order>

@{
    ViewData["Title"] = "Orders";
    var q = Context.Request.Query["q"].ToString();
    var status = Context.Request.Query["status"].ToString();
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var names = ViewData["CustomerNames"] as System.Collections.Generic.IDictionary<int, string>
                ?? new Dictionary<int, string>();
    var statuses = OrderStatus.All;
}

<div class="page-head">
    <h1>All Orders</h1>
</div>

<!-- Search & Filters BELOW header -->
<div class="search-card mb-3">
    <form method="get">
        <!-- Section title (optional, matches your UI tone) -->
        <div class="row">
            <div class="col-12">
                <h5 class="mb-2">Filter orders</h5>
            </div>
        </div>

        <div class="row g-2 align-items-end">
            <!-- Row 1: Search + Date range + Status -->
            <div class="col-12 col-md-3">
                <label class="form-label mb-1">Order ID</label>
                <input class="form-control" type="text" name="q" value="@q" placeholder="Search Order ID" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">From</label>
                <input class="form-control" type="date" name="dateFrom" value="@(ViewData["dateFrom"])" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">To</label>
                <input class="form-control" type="date" name="dateTo" value="@(ViewData["dateTo"])" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label mb-1">Status</label>
                <select class="form-select select-contrast" name="status">
                    <option value="">Status: All</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(string.Equals(status, s, StringComparison.OrdinalIgnoreCase))">@s</option>
                    }
                </select>
            </div>

            <!-- Row 2: Totals + Item counts -->
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Min total</label>
                <input class="form-control" type="number" step="0.01" name="minTotal" value="@(ViewData["minTotal"])" placeholder="e.g. 100.00" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Max total</label>
                <input class="form-control" type="number" step="0.01" name="maxTotal" value="@(ViewData["maxTotal"])" placeholder="e.g. 500.00" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Min items</label>
                <input class="form-control" type="number" name="minItems" value="@(ViewData["minItems"])" placeholder="e.g. 1" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label mb-1">Max items</label>
                <input class="form-control" type="number" name="maxItems" value="@(ViewData["maxItems"])" placeholder="e.g. 10" />
            </div>

            <!-- Row 3: Actions -->
            <div class="col-12 d-flex gap-2 justify-content-end">
                <a class="btn btn-outline-light" href="@Url.Action("Index", "Order")" title="Reset">Reset</a>
                <button class="btn btn-primary" type="submit" title="Filter">
                    <i class="bi bi-search"></i> Apply
                </button>
            </div>
        </div>
    </form>
</div>
<div data-orders-autorefresh="true">
    @if (!Model.Any())
    {
        <div class="empty">No orders found.</div>
    }
    else
    {
        <div class="search-card">
            <table class="table table-neon">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th class="text-end">Items</th>
                        <th class="text-end">Total</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.OrderByDescending(x => x.OrderDate))
                    {
                        var nm = (int.TryParse(o.CustomerId, out var cid) && names.ContainsKey(cid))
                        ? names[cid]
                        : "Unknown Customer";

                        <tr>
                            <td class="truncate-28">@o.RowKey</td>
                            <td class="truncate-28">@nm</td>
                            <td>@($"{o.OrderDate:yyyy-MM-dd HH:mm}")</td>
                            <td class="text-end">@o.ItemCount</td>
                            <td class="text-end">R @o.TotalPrice.ToString("0.00")</td>

                            <td>
                                @if (o.Status == "Placed")
                                {
                                    <span class="badge-soft status-placed rounded-pill px-2 py-1">@o.Status</span>
                                }
                                else if (o.Status == "Processed")
                                {
                                    <span class="badge-soft status-processing rounded-pill px-2 py-1">@o.Status</span>
                                }
                                else if (o.Status == "Completed")
                                {
                                    <span class="badge-soft status-completed rounded-pill px-2 py-1">@o.Status</span>
                                }
                                else if (o.Status == "Cancelled")
                                {
                                    <span class="badge-soft status-cancelled rounded-pill px-2 py-1">@o.Status</span>
                                }
                                else
                                {
                                    <span class="badge-soft rounded-pill px-2 py-1">@o.Status</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 align-items-center">

                                    <a class="btn btn-sm btn-outline-light"
                                       asp-action="AdminDetails"
                                       asp-route-id="@o.RowKey"
                                       asp-route-returnUrl="@returnUrl"
                                       title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-2 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@o.RowKey" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                                        <select class="form-select select-contrast" name="status">
                                            @foreach (var s in statuses)
                                            {
                                                <option value="@s"
                                                        selected="@(string.Equals(o.Status, s, StringComparison.OrdinalIgnoreCase))">
                                                    @s
                                                </option>
                                            }
                                        </select>

                                        <button type="submit" class="btn btn-sm btn-outline-light" title="Save">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

