@using Azure.Storage.Queues.Models
@using System.Web
@model List<string>
@{
    ViewData["Title"] = "Queue Messages";
    ViewData["Subtitle"] = "Peek messages currently in Azure Queue";
    var count = Model?.Count ?? 0;
}

<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-sub">@ViewData["Subtitle"]</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge badge-soft">@count message@(count == 1 ? "" : "s")</span>
        <a asp-action="Peek" class="btn btn-outline-light">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
        </a>
    </div>
</div>

<!-- Anti-forgery token holder for delete.js -->
<div id="__af">@Html.AntiForgeryToken()</div>

<div class="glass-card p-3">
    @if (Model == null || !Model.Any())
    {
        <div class="empty">
            <i class="bi bi-inboxes icon"></i>
            <div>No messages in queue.</div>
            <div class="mt-2">
                <a asp-action="Peek" class="btn btn-primary btn-sm">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap gap-2 justify-content-between mb-3">
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-light btn-sm" id="copyVisible">
                    <i class="bi bi-clipboard-check me-1"></i> Copy visible
                </button>
                <button type="button" class="btn btn-outline-light btn-sm" id="copyAll">
                    <i class="bi bi-clipboard me-1"></i> Copy all
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <ul class="list-group list-group-flush queue-list">
                @foreach (var msg in Model)
                {
                    <li class="list-group-item d-flex align-items-start justify-content-between queue-item">
                        <div class="min-w-0">
                            <div class="btn btn-outline-light btn-sm">#@msg</div>
                        </div>
                    </li>
                }

            </ul>
        </div>
    }
</div>

<partial name="_ConfirmDeleteModal" />

@section Styles {
    <link rel="stylesheet" href="~/css/delete.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/queue-peek.js" asp-append-version="true"></script>
    <script src="~/js/queue-delete.js" asp-append-version="true"></script>
}
