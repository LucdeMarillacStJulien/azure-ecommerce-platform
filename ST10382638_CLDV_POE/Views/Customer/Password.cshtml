@model PasswordVm
@{
    ViewData["Title"] = "Set Password";
    ViewData["Subtitle"] = "Create the account password";
}

<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-sub">@ViewData["Subtitle"]</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-outline-light">
            <i class="bi bi-arrow-left-short me-1"></i> Back
        </a>
    </div>
</div>

<div class="glass-card form-card">
    <form asp-action="Password" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label for="pwd" class="form-label">Password</label>
                <input id="pwd" name="Password" type="password" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label for="cpwd" class="form-label">Confirm Password</label>
                <input id="cpwd" name="ConfirmPassword" type="password" class="form-control" required />
            </div>
        </div>

        <div class="mt-3 small text-muted">
            Must include: 8+ chars, upper, lower, digit, special.
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> Save
            </button>
            <a asp-action="Create" class="btn btn-outline-light">
                <i class="bi bi-x-lg me-1"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
