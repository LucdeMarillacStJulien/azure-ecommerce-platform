@model IEnumerable<ST10382638_CLDV_POE.Models.Product>

@{
    ViewData["Title"] = "Shop";
    ViewData["Subtitle"] = "Choose a product to view details";

    // Read current filter values from the query string so we can keep them in the form.
    var name = Context.Request.Query["name"].ToString();
    var category = Context.Request.Query["category"].ToString();

    // Categories for the dropdown: supplied by controller, fall back to ProductCategories.List.
    IEnumerable<string> categories = ViewBag.Categories ?? ST10382638_CLDV_POE.Models.ProductCategories.List;
}

<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-sub">@ViewData["Subtitle"]</p>
    </div>
</div>

<!-- Search & Filters BELOW header -->
<div class="search-card mb-3">
    <form method="get">
        <div class="row g-3 align-items-end">
            <!-- Name filter -->
            <div class="col-12 col-md-6">
                <label class="form-label mb-1" for="name">Product name</label>
                <input class="form-control"
                       type="text"
                       id="name"
                       name="name"
                       value="@name"
                       placeholder="Search by product name" />
            </div>

            <!-- Category filter -->
            <div class="col-12 col-md-4">
                <label class="form-label mb-1" for="category">Category</label>
                <select class="form-select select-contrast" id="category" name="category">
                    <option value="">All categories</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c"
                                selected="@(string.Equals(category, c, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                            @c
                        </option>
                    }
                </select>
            </div>

            <!-- Actions -->
            <div class="col-12 col-md-2 d-flex gap-2 justify-content-end">
                <a class="btn btn-outline-light flex-grow-1"
                   href="@Url.Action("Main", "Customer")">
                    Reset
                </a>
                <button class="btn btn-primary flex-grow-1" type="submit">
                    Filter
                </button>
            </div>
        </div>
    </form>
</div>

@if (!(Model?.Any() ?? false))
{
    <section class="container my-4">
        <div class="glass-card p-4 rounded-4 text-center">
            <p class="mb-0">No products available right now.</p>
        </div>
    </section>
}
else
{
    <!-- SCOPE STARTS HERE -->
    <section class="shop-catalog container my-4">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
            @foreach (var p in Model)
            {
                var fallbackImg = Url.Content("~/img/placeholder-product.png");
                var imgSrc = string.IsNullOrWhiteSpace(p.ImageUrl) ? fallbackImg : p.ImageUrl;

                <div class="col">
                    <a asp-action="Shop" asp-route-id="@p.RowKey" class="text-decoration-none d-block h-100">
                        <div class="glass-card product-card h-100 p-0 rounded-4 overflow-hidden d-flex flex-column">
                            <div style="height:280px; overflow:hidden; border-bottom:1px solid rgba(255,255,255,0.1);">
                                <img src="@imgSrc" alt="@p.ProductName" class="w-100 h-100 object-fit-cover" />
                            </div>
                            <div class="p-3 d-flex flex-column gap-1 text-white">
                                <h2 class="h6 mb-1">@p.ProductName</h2>
                                <p class="mb-2 text-muted small">@p.Description</p>
                                <div class="d-flex align-items-center justify-content-between mt-auto">
                                    <span class="badge">@p.Category</span>
                                    <span class="fw-semibold">R @p.Price.ToString("0.00")</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}
