@model ST10382638_CLDV_POE.Models.Product

@{
    var title = Model?.ProductName ?? "Product";
    var img = string.IsNullOrWhiteSpace(Model?.ImageUrl)
        ? Url.Content("~/img/placeholder-product.png")
        : Model!.ImageUrl;
    var inStock = (Model?.StockQuantity ?? 0) > 0;
    var price = (decimal)(Model?.Price ?? 0);
}

<section class="shop-view container my-4">
    <header class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="mb-0">@title</h1>
        <a asp-controller="Customer" asp-action="Main" class="btn btn-outline-light">Back</a>
    </header>

    <div class="row g-4">
        <!-- LEFT: media -->
        <div class="col-12 col-lg-7">
            <div class="glass-card shop-media">
                <img src="@img" alt="@title" />
            </div>
        </div>

        <!-- RIGHT: price (static), then details, then description -->
        <div class="col-12 col-lg-5">
            <!-- PRICE -->
            <div class="glass-card p-3 mb-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="text-muted small">Price</div>
                        <div class="fs-3 fw-bold">R @price.ToString("0.00")</div>
                    </div>
                    <div>
                        @if (inStock)
                        {
                            <span class="badge">@Model?.StockQuantity left</span>
                        }
                        else
                        {

                            <span class="badge">Unavailable</span>
                        }
                    </div>
                </div>

                <hr class="my-3" />

                <div class="d-flex align-items-center gap-2">
                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="productId" value="@Model!.RowKey" />
                        <input type="hidden" name="productName" value="@Model!.ProductName" />
                        <input type="hidden" name="unitPrice" value="@Convert.ToDecimal(Model!.Price).ToString("0.00")" />
                        <input type="hidden" name="imageUrl" value="@Model!.ImageUrl" />
                        <label for="qty" class="form-label mb-0">Qty</label>
                        <input id="qty" name="qty" class="form-control text-center shop-qty" type="number" min="1" value="1" />
                        <button type="submit" class="btn btn-primary" @( (Model.StockQuantity > 0) ? null : "disabled")>Add to cart</button>
                        @Html.AntiForgeryToken()
                    </form>
                </div>
            </div>

            <!-- DETAILS (below price) -->
            <div class="glass-card p-3 mb-3">
                <h2 class="h5 mb-3">Details</h2>
                <dl class="shop-dl mb-0">
                    <dt>Name</dt>
                    <dd>@Model?.ProductName</dd>
                    <dt>Category</dt>
                    <dd>@Model?.Category</dd>
                    <dt>SKU</dt>
                    <dd>@Model?.RowKey</dd>
                    <dt>Status</dt>
                    <dd>
                        @if (inStock)
                        {
                            <span class="badge">In stock</span>
                        }
                        else
                        {

                            <span class="badge">Out of stock</span>
                        }
                    </dd>
                </dl>
            </div>

            <!-- DESCRIPTION (below details) -->
            <div class="glass-card p-3">
                <h2 class="h5 mb-2">Description</h2>
                <p class="mb-0">
                    @(string.IsNullOrWhiteSpace(Model?.Description)
                                        ? "No description provided."
                                        : Model!.Description)
                </p>
            </div>
        </div>
    </div>
</section>