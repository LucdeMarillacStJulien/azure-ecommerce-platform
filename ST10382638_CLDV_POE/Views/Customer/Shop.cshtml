@model ST10382638_CLDV_POE.Models.Product
@{
    ViewData["Title"] = Model?.ProductName ?? "Product";
    ViewData["Subtitle"] = "Review and decide";
    var fallbackImg = Url.Content("~/img/placeholder-product.png");
    var imgSrc = string.IsNullOrWhiteSpace(Model?.ImageUrl) ? fallbackImg : Model.ImageUrl;
    var inStock = (Model?.StockQuantity ?? 0) > 0;
}

<div class="page-head">
    <div>
        <h1 class="mb-0">@ViewData["Title"]</h1>
        <p class="page-sub">@ViewData["Subtitle"]</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Main" class="btn btn-outline-light">
            <i class="bi bi-arrow-left-short me-1"></i> Back to Shop
        </a>
    </div>
</div>

<section class="shop-detail container my-4">
    <div class="row g-4">
        <!-- Left: media + description -->
        <div class="col-lg-7">
            <!-- Media panel -->
            <div class="glass-card rounded-4 overflow-hidden">
                <div class="sd-media">
                    <img src="@imgSrc" alt="@Model?.ProductName" class="w-100 h-100 object-fit-cover" />
                </div>
            </div>

            <!-- Description -->
            <div class="glass-card rounded-4 p-4 mt-4">
                <h2 class="h5 mb-3">Description</h2>
                <p class="mb-0 text-muted">@Model?.Description</p>
            </div>
        </div>

        <!-- Right: purchase panel -->
        <div class="col-lg-5">
            <div class="glass-card rounded-4 p-4 sd-sticky">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge">@Model?.Category</span>
                    <span class="small text-muted">SKU: @Model?.RowKey</span>
                </div>

                <div class="d-flex align-items-end justify-content-between">
                    <div>
                        <div class="text-muted small mb-1">Price</div>
                        <div class="h4 mb-0">R @(Model?.Price.ToString("0.00"))</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted mb-1">Availability</div>
                        <div class="fw-semibold @(inStock ? "text-success" : "text-danger")">
                            @(inStock ? $"{Model!.StockQuantity} in stock" : "Out of stock")
                        </div>
                    </div>
                </div>

                <hr class="my-3" />

                <div class="d-flex gap-3 align-items-center">
                    <label class="form-label mb-0 small">Quantity</label>
                    <input type="number" class="form-control sd-qty" value="1" min="1" @(inStock ? "" : "disabled") />
                </div>

                <div class="mt-3 d-grid gap-2">
                    <button class="btn btn-primary" disabled title="Cart coming soon">
                        <i class="bi bi-bag-plus me-1"></i> Add to cart
                    </button>
                    <a asp-action="Main" class="btn btn-outline-light">Keep browsing</a>
                </div>

                <div class="mt-4 small text-muted">
                    Safe checkout. Secure payment. Easy returns.
                </div>
            </div>

            <!-- Quick facts (reusable block) -->
            <div class="glass-card rounded-4 p-4 mt-4">
                <h3 class="h6 mb-3">Quick facts</h3>
                <ul class="sd-facts">
                    <li><span>Category</span><span class="text-white">@Model?.Category</span></li>
                    <li><span>Price</span><span class="text-white">R @(Model?.Price.ToString("0.00"))</span></li>
                    <li>
                        <span>Status</span>
                        <span class="@(inStock ? "text-success" : "text-danger")">
                            @(inStock ? "Available" : "Out of stock")
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        /* Scoped to product detail. Uses existing theme vars and UI classes. */
        .shop-detail .sd-media {
            height: 520px; /* portrait feel */
            background: var(--card); /* matches glass theme */
        }

            .shop-detail .sd-media img {
                width: 100%;
                height: 100%;
                object-fit: cover; /* Bootstrap utility present; keep explicit for safety */
                display: block;
            }

        /* Sticky purchase panel on large screens */
        @media (min-width: 992px) {
            .shop-detail .sd-sticky

        {
            position: sticky;
            top: 24px;
        }

        }

        /* Controls */
        .shop-detail .sd-qty {
            max-width: 110px;
        }

        /* Quick facts list */
        .shop-detail .sd-facts {
            list-style: none;
            margin: 0;
            padding: 0;
        }

            .shop-detail .sd-facts li {
                display: flex;
                justify-content: space-between;
                gap: 1rem;
                border-bottom: 1px dashed var(--card-border);
                padding: .5rem 0;
            }

                .shop-detail .sd-facts li:last-child {
                    border-bottom: 0;
                }
    </style>
}
