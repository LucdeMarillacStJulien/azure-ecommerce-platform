@model ST10382638_CLDV_POE.Models.Customer
@{
    ViewData["Title"] = "Customer Details";
    ViewData["Subtitle"] = "Full profile";
}

<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-sub">@ViewData["Subtitle"]</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-arrow-left-short me-1"></i> Back
        </a>
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
    </div>
</div>

<div class="glass-card p-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Customer ID</dt>
        <dd class="col-sm-9">@Model.CustomerId</dd>
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>
        <dt class="col-sm-3">DOB</dt>
        <dd class="col-sm-9">@Model.DOB.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>
        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>
        <dt class="col-sm-3">Company</dt>
        <dd class="col-sm-9">@Model.Company</dd>
        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">
            @Model.AddressLine1<br />
            @Model.AddressLine2<br />
            @Model.City, @Model.State @Model.ZipCode<br />
            @Model.Country
        </dd>
    </dl>

    <div class="mt-3 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <button type="button"
                class="btn btn-outline-danger"
                data-confirm-delete
                data-delete-url="@Url.Action("Delete", new { id = Model.CustomerId })"
                data-item-label="@($"{Model.FirstName} {Model.LastName}")">
            <i class="bi bi-trash me-1"></i> Delete
        </button>
    </div>
</div>

<partial name="_ConfirmDeleteModal" />

@section Styles {
    <link rel="stylesheet" href="~/css/delete.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/delete.js" asp-append-version="true"></script>
}
