@model IEnumerable<ST10382638_CLDV_POE.Models.Customer>

@{
    ViewData["Title"] = "Customers";
    ViewData["Subtitle"] = "Manage customer profiles in Azure Table Storage";

    // Current search term from the query string (for sticky input value).
    var q = Context.Request.Query["q"].ToString();
}

<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-sub">@ViewData["Subtitle"]</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Customer
        </a>
    </div>
</div>



<div class="search-card mb-3">
    <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 align-items-end">

        <!-- Search input (grows to fill space) -->
        <div class="flex-grow-1">
            <label class="form-label mb-1" for="q">Search by name</label>
            <div class="input-group">
                <input name="q"
                       id="q"
                       type="text"
                       class="form-control"
                       placeholder="Enter first or last name"
                       value="@q" />
            </div>
        </div>

        <!-- Action buttons (fixed width, stay together) -->
        <div class="d-flex flex-column flex-sm-row gap-2">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-search me-1"></i> Search
            </button>

            <a href="@Url.Action("Index", "Customer")"
               class="btn btn-outline-light">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </a>
        </div>

    </form>
</div>

@if (!string.IsNullOrEmpty(ViewBag.Message as string))
{
    <div class="alert-soft alert-soft-warning mt-2" role="status" aria-live="polite">
        <i class="bi bi-exclamation-triangle-fill icon"></i> @ViewBag.Message
    </div>
    <br />
}

<div class="glass-card p-3">
    @if (Model == null || !Model.Any())
    {
        <div class="empty">
            <i class="bi bi-people icon"></i>
            <div>No customers yet.</div>
            <div class="mt-2">
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Add Customer
                </a>
            </div>
        </div>
    }
    else
    {


        <div class="table-responsive">
            <table class="table table-neon table-compact align-middle">
                <thead class="table-head-sticky">
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th class="d-none d-md-table-cell">Date of Birth</th>
                        <th class="text-center">Age</th>
                        <th class="d-none d-lg-table-cell">Phone</th>
                        <th class="d-none d-xl-table-cell">City</th>
                        <th class="d-none d-xl-table-cell">Country</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        var dob = c.DOB.Date;
                        var today = DateTime.Today;
                        var age = today.Year - dob.Year;
                        if (dob > today.AddYears(-age)) age--;
                        <tr>
                            <td>@c.CustomerId</td>
                            <td>@c.FirstName @c.LastName</td>

                            <td class="d-none d-md-table-cell">
                                @c.DOB.ToString("yyyy-MM-dd")
                            </td>

                            <td class="text-center">@age</td>

                            

                            <td class="d-none d-lg-table-cell">
                                @c.PhoneNumber
                            </td>

                            <td class="d-none d-lg-table-cell">
                                @c.Company
                            </td>

                            <td class="d-none d-xl-table-cell">
                                @c.City, @c.Country
                            </td>

                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-light" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-light" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="#"
                                       class="btn btn-outline-light js-delete-customer"
                                       data-id="@c.CustomerId"
                                       data-name="@($"{c.FirstName} {c.LastName}")">
                                       <i class="bi bi-trash me-1"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-2 text-muted small">
            <i class="bi bi-sliders me-1"></i>Long columns are truncated. Open <strong>Details</strong> to see full info
            (Address, State/Province, Zip) which we hide here to keep the list compact.
        </div>
    }
</div>

<partial name="_ConfirmDeleteModal" />

@section Styles {
    <link rel="stylesheet" href="~/css/delete.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/delete.js" asp-append-version="true"></script>
}