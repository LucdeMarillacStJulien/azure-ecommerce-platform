@{
    ViewData["Title"] = "Home";
}


<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">ABC Retail Cloud Management Portal</h1>
        <p class="text-muted mb-0">Choose a section to get started</p>
    </div>



    <div class="row g-4 justify-content-center home-grid">
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Customer" asp-action="Index" class="btn btn-home w-100">
                <i class="bi bi-people-fill me-2" aria-hidden="true"></i>
                <span>Customers</span>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Product" asp-action="Index" class="btn btn-home w-100">
                <i class="bi bi-box-seam-fill me-2" aria-hidden="true"></i>
                <span>Products</span>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Inventory" asp-action="Peek" class="btn btn-home w-100">
                <i class="bi bi-boxes me-2" aria-hidden="true"></i>
                <span>Inventory</span>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Order" asp-action="Index" class="btn btn-home w-100">
                <i class="bi bi-cart-check-fill me-2" aria-hidden="true"></i>
                <span>Order</span>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Contract" asp-action="Index" class="btn btn-home w-100">
                <i class="bi bi-cloud-arrow-up-fill me-2" aria-hidden="true"></i>
                <span>Contracts</span>
            </a>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}