@model List<string>
@{
    ViewData["Title"] = "Contracts";
    ViewData["Subtitle"] = "Upload, generate, list & download (Azure Files)";
}
<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-sub">@ViewData["Subtitle"]</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}

<div class="row g-3">
    <div class="col-xl-6">
        <div class="glass-card form-card">
            <h5 class="mb-3">Upload Contract</h5>
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-2 align-items-center">
                    <div class="col">
                        <label class="form-label">Choose file</label>
                        <input type="file" name="file" class="form-control" accept=".pdf,.doc,.docx,.txt" />
                        <div class="input-hint">PDF, DOC, DOCX, TXT</div>

                    </div>
                    <div class="col-auto">
                        <button class="btn btn-primary"><i class="bi bi-upload me-1"></i>Upload</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="glass-card p-3 mt-3">
    <h5 class="mb-3">Contracts (@(Model?.Count ?? 0))</h5>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty">
            <span class="icon">📄</span>
            No files yet — upload or generate a few to get started.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-neon table-compact align-middle">
                <thead class="table-head-sticky">
                    <tr>
                        <th>File name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in Model)
                    {
                        <tr>
                            <td><span class="link-truncate">@file</span></td>
                            <td class="text-end actions">
                                <a asp-action="Download" asp-route-fileName="@file" class="btn btn-outline-light btn-sm me-1">
                                    <i class="bi bi-download me-1"></i>Download
                                </a>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="fileName" value="@file" />
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/delete.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/delete.js" asp-append-version="true"></script>
}