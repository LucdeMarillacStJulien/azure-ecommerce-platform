@model ST10382638_CLDV_POE.Models.Product

@{
    ViewData["Title"] = "Product Details";
    ViewData["Subtitle"] = "Full product information";

    var fallbackImg = Url.Content("~/img/placeholder-product.png");
    var imgSrc = string.IsNullOrWhiteSpace(Model.ImageUrl) ? fallbackImg : Model.ImageUrl;
    var ext = System.IO.Path.GetExtension(imgSrc)?.ToLowerInvariant();
    bool isVideo = ext is ".mp4" or ".webm" or ".mov" or ".avi" or ".mkv";
}

<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-sub">@ViewData["Subtitle"]</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.RowKey" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-arrow-left-short me-1"></i> Back
        </a>
    </div>
</div>

<div class="glass-card p-3">
    <div class="row g-4 align-items-start">
        <div class="col-lg-5">
            <div class="product-hero">
                @if (isVideo)
                {
                    <video class="product-hero__img"
                           src="@imgSrc"
                           autoplay
                           muted
                           loop
                           playsinline
                           preload="metadata"
                           controlslist="nodownload noplaybackrate noremoteplayback nofullscreen"
                           disablepictureinpicture
                           oncontextmenu="return false">
                    </video>
                }
                else
                {
                    <img src="@imgSrc"
                         alt="@Model.ProductName"
                         class="product-hero__img"
                         referrerpolicy="no-referrer" />
                }
            </div>
        </div>

        <div class="col-lg-7">
            <h3 class="mb-2 fw-semibold">@Model.ProductName</h3>

            <div class="d-flex flex-wrap gap-2 mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.Category))
                {
                    <span class="badge badge-soft">@Model.Category</span>
                }

                @if (Model.IsAvailable)
                {
                    <span class="badge badge-yes"><i class="bi bi-check2 me-1"></i>In stock (@Model.StockQuantity)</span>
                }
                else
                {
                    <span class="badge badge-no"><i class="bi bi-x-lg me-1"></i>Unavailable</span>
                }
            </div>

            <div class="fs-4 fw-semibold mb-3">R @Model.Price.ToString("F2")</div>

            <dl class="row detail-dl">
                <dt class="col-sm-4">Stock quantity</dt>
                <dd class="col-sm-8">@Model.StockQuantity</dd>
            </dl>

            <div class="mt-3 d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.RowKey" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-outline-light">
                    <i class="bi bi-arrow-left-short me-1"></i> Back to list
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <hr class="my-4" />
        <div>
            <h5 class="mb-2">Description</h5>
            <p class="text-muted mb-0">@Model.Description</p>
        </div>
    }
</div>
